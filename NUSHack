async function startGoogleSignIn(){
  if (CFG.backend !== 'supabase' || !CFG.supabaseUrl || !CFG.supabaseKey) return authMsg('Needs Supabase backend.', 'info');
  try {
    const { verifier, challenge } = await generatePKCE();
    sessionStorage.setItem('safesync.pkce_verifier', verifier);
    sessionStorage.setItem('safesync.oauth_in_flight', '1');
    sessionStorage.setItem('safesync.oauth_device', deviceId);
    sessionStorage.setItem('safesync.oauth_at', String(Date.now()));
  } catch (e){ return authMsg('Browser does not support secure OAuth.', 'error'); }

  const redirect = window.location.origin + window.location.pathname;
  const qs = new URLSearchParams({ provider: 'google', redirect_to: redirect, code_challenge: challenge, code_challenge_method: 'S256' });
  window.location.href = CFG.supabaseUrl + '/auth/v1/authorize?' + qs.toString();
}

async function handleOAuthReturn(){
  const url = new URL(window.location.href);
  const q = url.searchParams;
  const hash = url.hash.startsWith('#') ? url.hash.slice(1) : '';

  const hasCode = q.has('code');
  const hasImplicit = hash.includes('access_token=');
  const hasError = q.has('error') || q.has('error_description')
                || (hash && (hash.includes('error=') || hash.includes('error_description=')));

  if (!hasCode && !hasImplicit && !hasError) return false;

  const wasInFlight = sessionStorage.getItem('safesync.oauth_in_flight') === '1';
  const startedAt = Number(sessionStorage.getItem('safesync.oauth_at') || 0);
  sessionStorage.removeItem('safesync.oauth_in_flight');
  sessionStorage.removeItem('safesync.oauth_at');
  const verifier = sessionStorage.getItem('safesync.pkce_verifier');
  sessionStorage.removeItem('safesync.pkce_verifier');
  const savedDevice = sessionStorage.getItem('safesync.oauth_device');
  sessionStorage.removeItem('safesync.oauth_device');

  history.replaceState(null, '', url.pathname + (savedDevice ? '?device=' + encodeURIComponent(savedDevice) : ''));

  if (hasError){
    const msg = q.get('error_description') || q.get('error')
              || new URLSearchParams(hash).get('error_description')
              || new URLSearchParams(hash).get('error')
              || 'OAuth failed';
    if (/access_denied/i.test(msg) || /user.*cancel/i.test(msg)){
      authMsg('Sign-in cancelled.', 'info');
    } else {
      authMsg('Google sign-in failed: ' + msg, 'error');
    }
    return true;
  }

  if (!wasInFlight && !verifier && !hasImplicit) {
    authMsg('OAuth session expired or lost. Please try again.', 'warn'); return true;
  }

  try {
    let accessToken = null; let refreshToken = null; let expiresIn = 3600;
    if (hasCode){
      if (!verifier) throw new Error('Missing PKCE verifier — try again');
      const res = await fetchWithTimeout(CFG.supabaseUrl + '/auth/v1/token?grant_type=pkce', {
        method: 'POST', headers: { apikey: CFG.supabaseKey, 'Content-Type': 'application/json' },
        body: JSON.stringify({ auth_code: q.get('code'), code_verifier: verifier })
      });
      const d = await res.json().catch(()=>({}));
      if (!res.ok) throw new Error(d.msg || d.error_description || `Token exchange failed (${res.status})`);
      accessToken = d.access_token; refreshToken = d.refresh_token; expiresIn = d.expires_in || 3600;
    } else if (hasImplicit){
      const params = new URLSearchParams(hash); accessToken = params.get('access_token'); refreshToken = params.get('refresh_token'); expiresIn = Number(params.get('expires_in')) || 3600;
    }

    if (!accessToken) throw new Error('No access token in OAuth return');
    const vr = await fetchWithTimeout(CFG.supabaseUrl + '/auth/v1/user', { headers: { apikey: CFG.supabaseKey, Authorization: 'Bearer ' + accessToken } });
    if (!vr.ok) throw new Error('Token rejected by Supabase');
    const user = await vr.json();

    if (!isAllowedEmail(user.email || '')) { authMsg(`Signed in as ${user.email}. SafeSync requires an approved domain.`, 'error'); return true; }

    session.authToken = accessToken; session.refreshToken = refreshToken; session.authExpiry = Date.now() + expiresIn * 1000;
    session.user = { id: user.id, email: user.email, via: 'google' }; session.firewall1 = true; session.pendingEmail = user.email;
    await audit('AUTH google ok ' + user.email);

    const pinRecord = await getOne(local, 'auth', 'pin.' + user.id);
    authView = pinRecord ? 'pin' : 'pin-setup'; renderAuth();
    return true;
  } catch (err){ authMsg('Google sign-in failed: ' + err.message, 'error'); return true; }
}

