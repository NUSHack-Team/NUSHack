async function verifyPasswordAndAdvance(email, password){
  if (CFG.backend === 'supabase'){
    const r = await fetchWithTimeout(CFG.supabaseUrl + '/auth/v1/token?grant_type=password', { method: 'POST', headers: { apikey: CFG.supabaseKey, 'Content-Type': 'application/json' }, body: JSON.stringify({ email, password }) });
    if (!r.ok){ const err = await r.json().catch(()=>({})); throw new Error(err.error_description || err.msg || 'Invalid email or password'); }
    const d = await r.json();
    session.authToken = d.access_token; session.refreshToken = d.refresh_token; session.authExpiry = Date.now() + d.expires_in * 1000;
    session.user = { id: d.user.id, email: d.user.email || email, via: 'password' }; session.firewall1 = true;
    await recordAttempt('password', true); await audit('AUTH password ok ' + email + ' (supabase)');
  } else {
    const record = await getOne(local, 'auth', 'credentials.' + email);
    if (!record) throw new Error('No account for that email on this device');
    const computed = await pbkdf2(password, fromB64(record.passwordSalt), AUTH.PBKDF2_PASSWORD_ITER);
    if (!await constantTimeEqual(computed, record.passwordHash)) throw new Error('Incorrect password');
    session.user = { id: 'local::' + email, email, via: 'password' }; session.firewall1 = true;
    await recordAttempt('password', true); await audit('AUTH password ok ' + email + ' (demo)');
  }
  session.pendingEmail = email;
  const pinRecord = await getOne(local, 'auth', 'pin.' + session.user.id);
  authView = pinRecord ? 'pin' : 'pin-setup'; renderAuth();
}

