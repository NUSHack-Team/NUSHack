function pullWriteLocalAtomic(remoteEntities, newCursor){
  return new Promise((res, rej) => {
    let t; try { t = local.transaction(['entities','outbox','meta'],'readwrite'); } catch(e){ return rej(e); }
    const ents = t.objectStore('entities'), ob = t.objectStore('outbox'), meta = t.objectStore('meta'); let changed = 0;
    t.oncomplete = () => res({ changed }); t.onerror = () => rej(t.error); t.onabort = () => rej(t.error || new Error('aborted'));
    const obReq = ob.getAll();
    obReq.onsuccess = () => {
      const pending = new Set(obReq.result.map(o => o.entityKey + '|' + o.field));
      if (!remoteEntities.length){ meta.put({ k:'lastCursor.' + CFG.orgId, v: newCursor }); return; }
      let remaining = remoteEntities.length;
      for (const ce of remoteEntities){
        const g = ents.get(ce._key);
        g.onsuccess = () => {
          const le = g.result;
          if (!le){ ents.put(clone(ce)); changed++; }
          else {
            le.fields = le.fields || {}; le.fieldRevs = le.fieldRevs || {}; le.meta = le.meta || ce.meta || {}; let touched = false;
            for (const f of Object.keys(ce.fields || {})){ if (pending.has(ce._key + '|' + f)) continue; const cr = (ce.fieldRevs && ce.fieldRevs[f]) || 0; const lr = le.fieldRevs[f] || 0; if (cr > lr){ le.fields[f] = ce.fields[f]; le.fieldRevs[f] = cr; touched = true; } }
            if ((ce.cursor ?? 0) > (le.cursor ?? 0)) le.cursor = ce.cursor;
            if (touched){ ents.put(le); changed++; }
          }
          if (--remaining === 0) meta.put({ k:'lastCursor.' + CFG.orgId, v: newCursor });
        };
      }
    };
  });
}

let pullChain = Promise.resolve();
function pull(){ const run = pullChain.catch(()=>{}).then(_pullOnce); pullChain = run.catch(()=>{}); return run; }
async function _pullOnce(){ const m = await getOne(local, 'meta', 'lastCursor.' + CFG.orgId); const since = m ? m.v : -1; const remote = await Transport.pullSince(since, CFG.orgId); if (!remote.length) return 0; const maxC = remote.reduce((a,e) => Math.max(a, e.cursor ?? since), since); const { changed } = await pullWriteLocalAtomic(remote, maxC); return changed; }

let syncing = false; let forcedOffline = false;
const isOnline = () => !forcedOffline && navigator.onLine !== false;
let retryDelayMs = 0, retryTimer = null; const RETRY_MIN = 2000, RETRY_MAX = 60000;
function scheduleRetry(){ if (!isOnline()) return; clearTimeout(retryTimer); retryTimer = setTimeout(() => { if (isOnline() && !syncing) doSync(); }, retryDelayMs); retryDelayMs = retryDelayMs ? Math.min(retryDelayMs*2, RETRY_MAX) : RETRY_MIN; }
function resetRetry(){ clearTimeout(retryTimer); retryDelayMs = 0; }

function ackOkAtomic(snapshot, result){
  return new Promise((res, rej) => {
    let t; try { t = local.transaction(['entities','outbox'],'readwrite'); } catch(e){ return rej(e); }
    const ents = t.objectStore('entities'), ob = t.objectStore('outbox'); let outcome;
    t.oncomplete = () => res(outcome); t.onerror = () => rej(t.error); t.onabort = () => rej(t.error || new Error('aborted'));
    const og = ob.get(snapshot.opId);
    og.onsuccess = () => {
      const current = og.result; const eg = ents.get(snapshot.entityKey);
      eg.onsuccess = () => {
        const ent = eg.result;
        if (ent && snapshot.action !== 'create' && Number.isFinite(result.rev)){ ent.fieldRevs = ent.fieldRevs || {}; const prev = ent.fieldRevs[snapshot.field] || 0; const next = Math.max(prev, result.rev); if (next !== prev){ ent.fieldRevs[snapshot.field] = next; ents.put(ent); } }
        if (!current){ outcome = 'gone'; return; }
        if (current.version === snapshot.version){ ob.delete(snapshot.opId); outcome = 'deleted'; }
        else { if(snapshot.action !== 'create') current.baseFieldRev = Math.max(current.baseFieldRev, result.rev); ob.put(current); outcome = 'kept'; }
      };
    };
  });
}

function ackConflictAtomic(snapshot, result){
  return new Promise((res, rej) => {
    let t; try { t = local.transaction(['conflicts','outbox'],'readwrite'); } catch(e){ return rej(e); }
    const conf = t.objectStore('conflicts'), ob = t.objectStore('outbox'); let outcome;
    t.oncomplete = () => res(outcome); t.onerror = () => rej(t.error); t.onabort = () => rej(t.error || new Error('aborted'));
    const og = ob.get(snapshot.opId);
    og.onsuccess = () => {
      const current = og.result; const useValue = current ? current.value : snapshot.value;
      const scan = conf.getAll();
      scan.onsuccess = () => {
        const existing = scan.result.find(c => c.opId === snapshot.opId);
        if (!existing){ conf.put({ id: uuid(), opId: snapshot.opId, entityKey: snapshot.entityKey, orgId: snapshot.orgId, plainId: snapshot.plainId, field: snapshot.field, localValue: useValue, serverValue: result.serverValue, baseRev: snapshot.baseFieldRev, serverRev: result.serverRev, deviceId, ts: Date.now() }); }
        ob.delete(snapshot.opId); outcome = 'conflict';
      };
    };
  });
}

function ackMissingAtomic(snapshot){
  return new Promise((res, rej) => {
    let t; try { t = local.transaction(['outbox','failedOps'],'readwrite'); } catch(e){ return rej(e); }
    const ob = t.objectStore('outbox'), fb = t.objectStore('failedOps'); let outcome;
    t.oncomplete = () => res(outcome); t.onerror = () => rej(t.error); t.onabort = () => rej(t.error || new Error('aborted'));
    const og = ob.get(snapshot.opId);
    og.onsuccess = () => {
      const current = og.result;
      if (current){ fb.put({ ...current, reason:'missing', failedAt: Date.now() }); ob.delete(snapshot.opId); }
      outcome = 'failed';
    };
  });
}

async function ackSnapshot(snapshot, result){
  const status = result && result.status;
  if (status === 'ok' || status === 'dup'){ await ackOkAtomic(snapshot, result); return; }
  if (status === 'conflict'){ await ackConflictAtomic(snapshot, result); return; }
  if (status === 'missing'){ await ackMissingAtomic(snapshot); return; }
  await audit('UNKNOWN RESPONSE ' + String(status)); throw new Error('Unknown server response: ' + String(status));
}

async function doSync(){
  if (syncing) return; if (!isOnline()){ toast('Offline'); return; }
  syncing = true; const btn = $('#syncBtn'); btn.disabled = true; btn.textContent = 'Syncing…';
  let ok=0, dup=0, conflicts=0, failed=0, pulled=0, pullOk = true, opsTotal = 0;
  try {
    const ops = await getAll(local, 'outbox'); opsTotal = ops.length;
    for (const op of ops){
      const snap = { opId: op.opId, version: op.version || 1, action: op.action || 'update', orgId: op.orgId, plainId: op.plainId, entityKey: op.entityKey, field: op.field, value: op.value, baseFieldRev: op.baseFieldRev, title: op.title, type: op.type, meta: op.meta, fields: op.fields };
      let r;
      try { r = snap.action === 'create' ? await Transport.createEntity(snap) : await Transport.applyOp(snap); }
      catch(netErr){ failed = opsTotal - (ok+dup+conflicts); break; }
      try {
        if (snap.action === 'create' && r.status === 'ok'){ await ackOkAtomic(snap, r); ok++; }
        else {
          if (!r || !['ok','dup','conflict','missing'].includes(r.status)) throw new Error('Unknown server response: ' + String(r && r.status));
          await ackSnapshot(snap, r);
          if (r.status === 'ok') ok++; else if (r.status === 'dup') dup++; else if (r.status === 'conflict') conflicts++; else if (r.status === 'missing') failed++;
        }
      } catch(ackErr){ failed++; console.error('[safesync] ack failed', ackErr, r); }
    }
    if (!failed){ try { pulled = await pull(); } catch(e){ pullOk = false; } }
  } finally { syncing = false; btn.disabled = false; btn.textContent = 'Sync now'; }

  const complete = !failed && pullOk;
  if (complete){ await putOne(local, 'meta', { k:'lastSync', v: Date.now() }); await audit('SYNC complete ok=' + ok + ' dup=' + dup + ' conflicts=' + conflicts + ' pulled=' + pulled); resetRetry(); }
  else { await audit('SYNC incomplete ok=' + ok + ' dup=' + dup + ' conflicts=' + conflicts + ' failed=' + failed + ' pullOk=' + pullOk); scheduleRetry(); }
  const parts = []; if (ok) parts.push(ok + ' pushed'); if (dup) parts.push(dup + ' duplicate'); if (conflicts) parts.push(conflicts + ' conflict'); if (failed) parts.push(failed + ' failed'); if (!pullOk) parts.push('pull FAILED'); else if (pulled) parts.push(pulled + ' pulled');
  toast((complete ? 'Synced: ' : 'Partial sync: ') + (parts.join(' · ') || 'nothing to do'));
  try { broadcast({ type:'sync', from: deviceId }); } catch(_){}
  render();
}

function resolveConflictAtomic(conflictId, choice){
  return new Promise((res, rej) => {
    let t; try { t = local.transaction(['entities','outbox','conflicts'],'readwrite'); } catch(e){ return rej(e); }
    const ents = t.objectStore('entities'), ob = t.objectStore('outbox'), conf = t.objectStore('conflicts'); let outcome;
    t.oncomplete = () => res(outcome); t.onerror = () => rej(t.error); t.onabort = () => rej(t.error || new Error('aborted'));
    const g = conf.get(conflictId);
    g.onsuccess = () => {
      const c = g.result; if (!c){ outcome = { error:'conflict not found' }; return; }
      const eg = ents.get(c.entityKey);
      eg.onsuccess = () => {
        const ent = eg.result; if (!ent){ outcome = { error:'entity missing' }; return; }
        ent.fields = ent.fields || {}; ent.fieldRevs = ent.fieldRevs || {};
        if (choice === 'local'){ ent.fields[c.field] = c.localValue; ent.fieldRevs[c.field] = Math.max(ent.fieldRevs[c.field] || 0, c.serverRev); ob.put({ opId: uuid(), action: 'update', orgId: c.orgId, plainId: c.plainId, entityKey: c.entityKey, field: c.field, value: c.localValue, baseFieldRev: c.serverRev, version: 1, deviceId, ts: Date.now() }); }
        else { ent.fields[c.field] = c.serverValue; ent.fieldRevs[c.field] = Math.max(ent.fieldRevs[c.field] || 0, c.serverRev); }
        ents.put(ent); conf.delete(conflictId); outcome = { ok: true, choice };
      };
    };
  });
}
async function resolveConflict(id, choice){ let r; try { r = await resolveConflictAtomic(id, choice); } catch(e){ return toast('Resolve failed: ' + e.message); } if (r && r.error){ toast('Cannot resolve: ' + r.error); return; } await audit('RESOLVE ' + choice + ' conflict ' + id); render(); }
async function retryFailedOp(opId){ const op = await getOne(local, 'failedOps', opId); if (!op) return; const fresh = { ...op, version: 1, ts: Date.now(), reason: undefined, failedAt: undefined }; await putOne(local, 'outbox', fresh); await delOne(local, 'failedOps', opId); await audit('RETRY ' + opId); render(); }
async function discardFailedOp(opId){ await delOne(local, 'failedOps', opId); await audit('DISCARD ' + opId); render(); }

const bc = ('BroadcastChannel' in window) ? new BroadcastChannel('safesync') : { postMessage(){}, onmessage:null };
function broadcast(m){ try { bc.postMessage(m); } catch(_){} }
bc.onmessage = async ev => { if (ev.data && ev.data.type === 'sync' && ev.data.from !== deviceId && isOnline() && session.authenticated){ try { await pull(); render(); } catch(_){} } };

let tab = 'processes';
function switchTab(name){ tab = name; document.querySelectorAll('nav button').forEach(b => b.classList.toggle('active', b.dataset.tab === name)); ['processes','sync','conflicts','audit'].forEach(t => { $('#tab-' + t).hidden = (t !== name); }); render(); }
function stateGlyph(v){ return v==='pending'?'○ pending':v==='done'?'✓ done':v==='blocked'?'✕ blocked':''; }

async function renderStatus(){
  const q = (await getAll(local, 'outbox')).length; const c = (await getAll(local, 'conflicts')).length; const f = (await getAll(local, 'failedOps')).length; const ls = await getOne(local, 'meta', 'lastSync');
  $('#qCount').textContent = q; $('#cCount').textContent = c; $('#fCount').textContent = f; $('#lastSync').textContent = ls ? new Date(ls.v).toLocaleTimeString() : 'never';
  $('#devBadge').textContent = deviceId; $('#orgBadge').textContent = CFG.orgId || '—';
  const on = isOnline(); const btn = $('#netBtn'); btn.textContent = forcedOffline ? 'Force offline' : (navigator.onLine === false ? 'Browser offline' : 'Online'); btn.className = 'pill ' + (on ? 'online' : 'offline'); document.body.classList.toggle('offline', !on);
  if (!on) $('#netHint').textContent = q + ' change(s) saved'; else if (f) $('#netHint').textContent = '⚠ ' + f + ' failed op(s)'; else if (q) $('#netHint').textContent = 'Ready to sync'; else $('#netHint').textContent = 'All changes synced';
}

function updateFieldUI(entityKey, field, value){ const card = document.querySelector('.card[data-key="' + CSS.escape(entityKey) + '"]'); if (!card) return; const ta = card.querySelector('textarea[data-field="' + CSS.escape(field) + '"]'); if (ta && ta.value !== String(value)) ta.value = value; }

async function renderProcesses(){
  const ents = (await getAll(local, 'entities')).filter(e => e.orgId === CFG.orgId);
  ents.sort((a,b) => b.updatedAt - a.updatedAt);
  const conflicts = await getAll(local, 'conflicts'); const outbox = await getAll(local, 'outbox'); const failed = await getAll(local, 'failedOps');
  if (!ents.length){ $('#process-list').innerHTML = '<div class="infobox">No processes yet. Click <b>+ New Process</b> to create one.</div>'; return; }
  
  const html = ents.map(e => {
    const hasConflict = conflicts.some(c => c.entityKey === e._key);
    const fields = Object.keys(e.fields).map(f => {
      const m = (e.meta && e.meta[f]) || { label:f, type:'text' }; const serverRev = (e.fieldRevs && e.fieldRevs[f]) || 0;
      const pending = outbox.some(o => o.entityKey === e._key && o.field === f); const failedOp = failed.some(o => o.entityKey === e._key && o.field === f);
      const pendChip = pending ? '<span class="pend-chip">unsynced</span>' : ''; const failChip = failedOp ? '<span class="pend-chip" style="background:#f85149;color:#fff">failed</span>' : '';
      if (m.type === 'status'){ const cur = e.fields[f];
        return `<div class="field"><label>${esc(m.label)} ${pendChip} ${failChip} <span class="rev" data-rev="${esc(f)}">server rev ${serverRev}</span> <span class="state-chip">${esc(stateGlyph(cur))}</span></label><div class="seg">
          ${['pending','done','blocked'].map(v => `<button data-act="set" data-field="${esc(f)}" data-val="${v}" aria-pressed="${cur === v}">${v[0].toUpperCase() + v.slice(1)}</button>`).join('')}
        </div></div>`;
      }
      return `<div class="field"><label>${esc(m.label)} ${pendChip} ${failChip} <span class="rev" data-rev="${esc(f)}">server rev ${serverRev}</span><span class="save-ind" data-ind="${esc(f)}"></span></label>
        <textarea data-field="${esc(f)}" maxlength="${MAX_FIELD_LEN}" placeholder="Type here…">${esc(e.fields[f])}</textarea></div>`;
    }).join('');
    return `<div class="card" data-key="${esc(e._key)}"><div class="card-h"><span class="tag">${esc(e.type)}</span><h3>${esc(e.title)}</h3> ${hasConflict ? '<span class="badge-warn">⚠ conflict</span>' : ''}</div>${fields}<div class="hint">Saved locally first · ${esc(deviceId)}</div></div>`;
  }).join('');
  $('#process-list').innerHTML = html;
}

async function renderSync(){
  const outbox = await getAll(local, 'outbox'); const failed = await getAll(local, 'failedOps'); const lastSync = await getOne(local, 'meta', 'lastSync'); const lastCur = await getOne(local, 'meta', 'lastCursor.' + CFG.orgId); const cCount = (await getAll(local, 'conflicts')).length;
  let swStatus = 'not supported'; if ('serviceWorker' in navigator){ const r = await navigator.serviceWorker.getRegistration(); swStatus = !r ? 'not registered' : r.active ? '✅ active' : r.installing ? '⏳ installing' : '⚠ registered'; }
  const ops = outbox.map(o => `<div class="op"><b>${esc(o.action === 'create' ? 'CREATE' : o.plainId + '.' + o.field)}</b> ← ${esc(String(o.value || o.title).slice(0,60))}<br>base rev ${o.baseFieldRev || 0} · v${o.version || 1} · ${esc(o.deviceId)}</div>`).join('') || '<div class="empty">Outbox empty.</div>';
  const failRows = failed.length ? failed.map(o => `<div class="op"><b>${esc(o.plainId)}.${esc(o.field)}</b><br>reason: ${esc(o.reason || 'unknown')}<div class="seg" style="margin-top:6px"><button data-retry="${esc(o.opId)}">Retry</button><button data-discard="${esc(o.opId)}">Discard</button></div></div>`).join('') : '<div class="op">failed operations: <b>0</b></div>';
  const tNote = CFG.backend === 'supabase' ? `<span class="pill online" style="margin-left:auto">Supabase · ${esc(CFG.orgId || 'no org')}</span>` : `<span class="pill" style="margin-left:auto;background:#2a3441;color:#8b98a5">Demo · ${esc(CFG.orgId)}</span>`;
  
  $('#tab-sync').innerHTML = `
    <div class="card"><div class="card-h"><h3>Transport</h3>${tNote}</div><div class="seg" style="margin-top:10px">
      <button id="toggleNet">${forcedOffline ? 'Go online' : 'Force offline'}</button>
      <button id="openDevice2">Open 2nd device tab</button>
      <button id="refreshPull">Pull from cloud</button>
      <label style="display:flex;align-items:center;gap:8px;flex:1;min-width:180px">Failure rate <input id="flakyRange" type="range" min="0" max="80" value="${Math.round(CFG.flaky*100)}" style="flex:1"><span id="flakyVal" style="font:12px ui-monospace;width:36px;text-align:right">${Math.round(CFG.flaky*100)}%</span></label>
    </div></div>
    <div class="card"><div class="card-h"><h3>Outbox</h3><span class="rev">${outbox.length} op(s)</span></div>${ops}</div>
    <div class="card"><div class="card-h"><h3>Failed</h3><span class="rev">${failed.length} op(s)</span></div>${failRows}</div>
    <div class="card"><div class="card-h"><h3>State</h3></div>
      <div class="op">org: <b>${esc(CFG.orgId || '—')}</b></div>
      <div class="op">user: <b>${esc(session.user?.email || '—')}</b> (${esc(session.user?.via || '—')})</div>
      <div class="op">service worker: <b>${esc(swStatus)}</b></div>
      <div class="op">last full sync: <b>${lastSync ? new Date(lastSync.v).toLocaleString() : 'never'}</b></div>
      <div class="op">pull cursor: <b>${lastCur ? lastCur.v : -1}</b></div>
      <div class="op">conflicts: <b>${cCount}</b></div>
    </div>`;

  $('#toggleNet').onclick = () => { forcedOffline = !forcedOffline; toast(forcedOffline ? 'Forced offline' : 'Back online'); render(); if (!forcedOffline && isOnline() && !syncing) doSync(); };
  $('#openDevice2').onclick = () => window.open(location.pathname + '?device=D-' + rand5(), '_blank');
  $('#refreshPull').onclick = async () => { if (!isOnline()) return toast('Offline'); try { const n = await pull(); toast('Pulled ' + n + ' change(s)'); } catch(e){ toast('Pull failed: ' + e.message); } render(); };
  const fr = $('#flakyRange'); if (fr) fr.oninput = () => { CFG.flaky = Number(fr.value)/100; $('#flakyVal').textContent = fr.value + '%'; };
  $('#tab-sync').querySelectorAll('[data-retry]').forEach(b => b.onclick = () => retryFailedOp(b.dataset.retry));
  $('#tab-sync').querySelectorAll('[data-discard]').forEach(b => b.onclick = () => discardFailedOp(b.dataset.discard));
}

async function renderConflicts(){
  const list = await getAll(local, 'conflicts'); if (!list.length){ $('#tab-conflicts').innerHTML = '<div class="empty">No conflicts.</div>'; return; }
  $('#tab-conflicts').innerHTML = list.map(c => `<div class="card"><div class="card-h"><span class="tag">Conflict</span><h3>${esc(c.plainId || c.entityKey)} · ${esc(c.field)}</h3></div>
    <div class="two"><div class="box"><h4>Your value (base rev ${c.baseRev})</h4><div class="v">${esc(String(c.localValue ?? '')) || '(empty)'}</div></div>
    <div class="box"><h4>Cloud value (rev ${c.serverRev})</h4><div class="v">${esc(String(c.serverValue ?? '')) || '(empty)'}</div></div></div>
    <div class="seg" style="margin-top:10px"><button class="ok" data-res="${esc(c.id)}" data-choice="local">Keep mine</button><button data-res="${esc(c.id)}" data-choice="server">Accept cloud</button></div></div>`).join('');
  $('#tab-conflicts').querySelectorAll('[data-res]').forEach(b => b.onclick = () => resolveConflict(b.dataset.res, b.dataset.choice));
}

async function renderAudit(){
  const all = (await getAll(local, 'audit')).reverse();
  const items = all.slice(0,60).map(a => `<div class="chain"><b>${esc(a.text)}</b><span class="h">${new Date(a.ts).toLocaleTimeString()} · ${esc(a.hash.slice(0,20))}…</span></div>`).join('') || '<div class="empty">No audit entries.</div>';
  $('#tab-audit').innerHTML = `<div class="card"><div class="card-h"><h3>Tamper-evident ledger</h3><button id="verifyBtn" style="margin-left:auto">Verify chain</button></div><div class="hint">Hash: prevHash + ts + device + text.</div></div>${items}`;
  $('#verifyBtn').onclick = async () => { const rows = await getAll(local, 'audit'); let prev = 'GENESIS', bad = 0; for (const r of rows){ const h = await auditHash(prev + '|' + r.ts + '|' + r.deviceId + '|' + r.text); if (h !== r.hash || r.prevHash !== prev) bad++; prev = r.hash; } toast(bad ? '❌ Chain broken' : '✅ Chain intact'); };
}

async function render(){
  if (!session.authenticated) return;
  await renderStatus();
  if (tab === 'processes') await renderProcesses();
  if (tab === 'sync') await renderSync();
  if (tab === 'conflicts') await renderConflicts();
  if (tab === 'audit') await renderAudit();
}

/* ================================================================
   Events & Boot
   ================================================================ */
document.querySelectorAll('nav button').forEach(b => b.onclick = () => switchTab(b.dataset.tab));
$('#syncBtn').onclick = doSync;
$('#netBtn').onclick = () => { forcedOffline = !forcedOffline; toast(forcedOffline ? 'Forced offline' : 'Back online'); if (!forcedOffline && isOnline()) doSync(); render(); };
$('#signOutBtn').onclick = () => { if (confirm('Sign out?')) signOut(); };

$('#newTaskBtn').onclick = () => { $('#modal-overlay').hidden = false; $('#taskTitle').value = ''; $('#taskTitle').focus(); };
$('#modalCancel').onclick = () => { $('#modal-overlay').hidden = true; };
$('#modalCreate').onclick = async () => {
  const title = $('#taskTitle').value.trim();
  if (!title) return alert('Please enter a title');
  $('#modal-overlay').hidden = true;
  await createNewTask(title, $('#taskTemplate').value);
};

$('#tab-processes').addEventListener('click', e => {
  const b = e.target.closest('button[data-act="set"]');
  if (!b) return;
  commitField(b.closest('.card').dataset.key, b.dataset.field, b.dataset.val);
});

const saveTimers = new Map();
function scheduleSave(entityKey, field, value, ind){ const key = entityKey + '|' + field; clearTimeout(saveTimers.get(key)?.t); if (ind) ind.textContent = 'editing…'; const t = setTimeout(async () => { saveTimers.delete(key); const r = await commitField(entityKey, field, value, { silent: true }); if (ind) ind.textContent = r?.error ? 'not saved' : 'saved'; }, 450); saveTimers.set(key, { t }); }
async function flushSave(entityKey, field, value, ind){ const key = entityKey + '|' + field; const e = saveTimers.get(key); if (!e) return; clearTimeout(e.t); saveTimers.delete(key); const r = await commitField(entityKey, field, value, { silent: true }); if (ind) ind.textContent = r?.error ? 'not saved' : 'saved'; }

$('#tab-processes').addEventListener('input', e => {
  const t = e.target.closest('textarea[data-field]');
  if (!t) return; const card = t.closest('.card'); const ind = card.querySelector('[data-ind="' + t.dataset.field + '"]'); scheduleSave(card.dataset.key, t.dataset.field, t.value, ind);
});
$('#tab-processes').addEventListener('blur', e => {
  const t = e.target.closest && e.target.closest('textarea[data-field]');
  if (!t) return; const card = t.closest('.card'); const ind = card.querySelector('[data-ind="' + t.dataset.field + '"]'); flushSave(card.dataset.key, t.dataset.field, t.value, ind);
}, true);

window.addEventListener('online', async () => { if (!session.authenticated) return; toast('Network restored'); const q = (await getAll(local, 'outbox')).length; if (q) await doSync(); else { try { await pull(); render(); } catch(_){} } });
window.addEventListener('offline', () => { if (session.authenticated) toast('Network lost'); render(); });

(async function main(){
  try { await initDBs(); } catch (e){ document.body.innerHTML = `<div class="warnbox" style="margin:40px">DB error: ${esc(e.message)}</div>`; return; }
  const oauth = await handleOAuthReturn(); if (oauth) return;
  session.authenticated = false; session.user = null; session.authToken = null; session.refreshToken = null; session.pendingEmail = null; session._demoCode = null;
  authView = 'login'; await renderAuth();
})();

if ('serviceWorker' in navigator && location.protocol.startsWith('http')){ navigator.serviceWorker.register('./sw.js').catch(e => console.warn('SW failed:', e)); }
</script>
