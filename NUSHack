let auditChain = Promise.resolve();
function audit(text){ auditChain = auditChain.then(() => _audit(text)).catch(e => console.warn('audit failed', e)); return auditChain; }
async function _audit(text){ const rows = await getAll(local, 'audit'); const prevHash = rows.length ? rows[rows.length-1].hash : 'GENESIS'; const ts = Date.now(); const hash = await auditHash(prevHash + '|' + ts + '|' + deviceId + '|' + text); await putOne(local, 'audit', { ts, text, deviceId, prevHash, hash }); }

const MAX_FIELD_LEN = 2000;

function saveFieldLocalAtomic(entityKey, field, value){
  return new Promise((res, rej) => {
    let t; try { t = local.transaction(['entities','outbox'],'readwrite'); } catch(e){ return rej(e); }
    const ents = t.objectStore('entities'), ob = t.objectStore('outbox'); let result;
    t.oncomplete = () => res(result); t.onerror = () => rej(t.error); t.onabort = () => rej(t.error || new Error('aborted'));
    if (typeof value === 'string' && value.length > MAX_FIELD_LEN) value = value.slice(0, MAX_FIELD_LEN);
    const g = ents.get(entityKey);
    g.onsuccess = () => {
      const ent = g.result; if (!ent){ result = { error:'missing' }; return; }
      const [orgId, plainId] = splitKey(entityKey); const baseRev = (ent.fieldRevs && ent.fieldRevs[field]) || 0;
      ent.fields = ent.fields || {}; ent.fieldRevs = ent.fieldRevs || {}; ent.fields[field] = value; ents.put(ent);
      const allReq = ob.getAll();
      allReq.onsuccess = () => {
        const existing = allReq.result.find(o => o.entityKey === entityKey && o.field === field);
        let op;
        if (existing){ existing.value = value; existing.version = (existing.version || 1) + 1; existing.ts = Date.now(); ob.put(existing); op = existing; }
        else { op = { opId: uuid(), action: 'update', orgId, plainId, entityKey, field, value, baseFieldRev: baseRev, version: 1, deviceId, ts: Date.now() }; ob.put(op); }
        result = { op, baseRev };
      };
    };
  });
}

async function commitField(entityKey, field, value, opts){
  opts = opts || {}; let r;
  try { r = await saveFieldLocalAtomic(entityKey, field, value); } catch(e){ toast('Save failed: ' + e.message); return { error: e.message }; }
  if (r && r.error){ toast('Process not found'); return r; }
  await audit('LOCAL ' + entityKey + '.' + field + ' = ' + String(value).slice(0,60));
  if (opts.silent){ updateFieldUI(entityKey, field, value); renderStatus(); } else { render(); }
  return r;
}

