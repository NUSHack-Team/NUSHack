function openDB(name, ver, upgrade){ return new Promise((res, rej) => { const r = indexedDB.open(name, ver); r.onupgradeneeded = () => upgrade(r.result); r.onsuccess = () => res(r.result); r.onerror = () => rej(r.error); }); }
function t1(db, s, m, run){ return new Promise((res, rej) => { let t; try { t = db.transaction(s, m); } catch(e){ return rej(e); } let out; t.oncomplete = () => res(out); t.onerror = () => rej(t.error); t.onabort = () => rej(t.error || new Error('aborted')); try { run(t.objectStore(s), v => { out = v; }); } catch(e){ try{t.abort();}catch(_){} rej(e); } }); }
const getAll = (db,n) => t1(db,n,'readonly', (s,set)=>{s.getAll().onsuccess=e=>set(e.target.result);});
const getOne = (db,n,k) => t1(db,n,'readonly', (s,set)=>{s.get(k).onsuccess=e=>set(e.target.result);});
const putOne = (db,n,v) => t1(db,n,'readwrite',(s)=>{s.put(v);});
const delOne = (db,n,k) => t1(db,n,'readwrite',(s)=>{s.delete(k);});

const LOCAL_DB = 'safesync.local.' + deviceId;
const CLOUD_DB = 'safesync.cloud';
let local, cloud;

async function initDBs(){
  local = await openDB(LOCAL_DB, 5, db => {
    if (!db.objectStoreNames.contains('entities'))  db.createObjectStore('entities',  { keyPath:'_key' });
    if (!db.objectStoreNames.contains('outbox'))    db.createObjectStore('outbox',    { keyPath:'opId' });
    if (!db.objectStoreNames.contains('conflicts')) db.createObjectStore('conflicts', { keyPath:'id' });
    if (!db.objectStoreNames.contains('failedOps')) db.createObjectStore('failedOps', { keyPath:'opId' });
    if (!db.objectStoreNames.contains('audit'))     db.createObjectStore('audit',     { keyPath:'seq', autoIncrement:true });
    if (!db.objectStoreNames.contains('meta'))      db.createObjectStore('meta',      { keyPath:'k' });
    if (!db.objectStoreNames.contains('attempts'))  db.createObjectStore('attempts',  { keyPath:'id', autoIncrement:true });
    if (!db.objectStoreNames.contains('auth'))      db.createObjectStore('auth',      { keyPath:'k' });
    if (!db.objectStoreNames.contains('otp'))       db.createObjectStore('otp',       { keyPath:'k' });
  });
  cloud = await openDB(CLOUD_DB, 2, db => {
    if (!db.objectStoreNames.contains('entities')) db.createObjectStore('entities', { keyPath:'_key' });
    if (!db.objectStoreNames.contains('ops'))      db.createObjectStore('ops',      { keyPath:'opId' });
    if (!db.objectStoreNames.contains('meta'))     db.createObjectStore('meta',     { keyPath:'k' });
  });
}

/* ================================================================
   Rate limiter & Code (demo only)
   ================================================================ */
async function recordAttempt(kind, success){
  await putOne(local, 'attempts', { kind, success, ts: Date.now() });
  if (success){ const all = await getAll(local, 'attempts'); for (const a of all){ if (a.kind === kind && !a.success) await delOne(local, 'attempts', a.id); } }
}
async function lockoutRemaining(kind){
  const all = await getAll(local, 'attempts'); const cutoff = Date.now() - 1800000;
  const fails = all.filter(a => a.kind === kind && !a.success && a.ts > cutoff);
  if (!fails.length) return { ms: 0, count: 0 };
  const base = kind === 'pin' ? 3 : kind === 'code' ? 4 : 2;
  const secs = Math.min(3600, Math.pow(base, fails.length));
  const ms = Math.max(0, Math.max(...fails.map(f => f.ts)) + secs * 1000 - Date.now());
  return { ms, count: fails.length };
}
function randomCode(){ const arr = new Uint32Array(1); crypto.getRandomValues(arr); return String(100000 + (arr[0] % 900000)); }
async function storeDemoCode(email, code){ const salt = randomSalt(); const hash = await pbkdf2(code, salt, AUTH.PBKDF2_CODE_ITER); await putOne(local, 'otp', { k: 'otp.' + email.toLowerCase(), email: email.toLowerCase(), hash, salt: toB64(salt), expiresAt: Date.now() + AUTH.CODE_TTL_MS, resends: 0, lastResendAt: Date.now() }); }
async function consumeDemoCode(email, code){
  const rec = await getOne(local, 'otp', 'otp.' + email.toLowerCase());
  if (!rec || Date.now() > rec.expiresAt) throw new Error('Code expired — request a new one');
  const hash = await pbkdf2(code, fromB64(rec.salt), AUTH.PBKDF2_CODE_ITER);
  if (!await constantTimeEqual(hash, rec.hash)) throw new Error('Incorrect code');
  await delOne(local, 'otp', rec.k); return true;
}
async function canResendCode(email){
  const rec = await getOne(local, 'otp', 'otp.' + email.toLowerCase());
  if (!rec) return { ok: true };
  if (rec.resends >= AUTH.CODE_MAX_RESENDS) return { ok: false, reason: 'Too many resends' };
  const wait = rec.lastResendAt + AUTH.CODE_RESEND_COOLDOWN_MS - Date.now();
  return wait > 0 ? { ok: false, waitMs: wait } : { ok: true };
}

