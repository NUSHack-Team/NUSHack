async function demoSignupAndDispatchCode(email, password){
  const existing = await getOne(local, 'auth', 'credentials.' + email);
  if (existing) throw new Error('An account with that email already exists');
  const salt = randomSalt(); const hash = await pbkdf2(password, salt, AUTH.PBKDF2_PASSWORD_ITER);
  await putOne(local, 'auth', { k: 'pending_credentials.' + email, email, passwordHash: hash, passwordSalt: toB64(salt), createdAt: Date.now() });
  const code = randomCode(); await storeDemoCode(email, code); session._demoCode = code;
}

async function supabaseSignupAndDispatchCode(email, password){
  const r = await fetchWithTimeout(CFG.supabaseUrl + '/auth/v1/signup', { method: 'POST', headers: { apikey: CFG.supabaseKey, 'Content-Type': 'application/json' }, body: JSON.stringify({ email, password, data: { signup_source: 'safesync' } }) });
  const d = await r.json().catch(()=>({}));
  if (!r.ok){ const msg = d.msg || d.error_description || d.error || 'Signup failed'; if (/already registered/i.test(msg)) throw new Error('Account exists. Sign in instead.'); throw new Error(msg); }
  if (d.access_token){
    session.authToken = d.access_token; session.refreshToken = d.refresh_token; session.authExpiry = Date.now() + d.expires_in * 1000;
    session.user = { id: d.user.id, email: d.user.email || email, via: 'password' }; session.firewall1 = true;
  }
}

async function renderCode(container){
  const email = session.pendingEmail;
  if (!email){ authView = 'signup'; return renderAuth(); }
  if (CFG.backend === 'supabase' && session.firewall1){
    const pinRecord = await getOne(local, 'auth', 'pin.' + session.user.id);
    authView = pinRecord ? 'pin' : 'pin-setup'; return renderAuth();
  }
  const demoBanner = CFG.backend === 'demo' && session._demoCode ? `<div class="demo-code"><span class="label">⚠ Demo mode — no real email sent</span>In production this code is emailed to <b style="display:inline;font-size:13px">${esc(email)}</b>.<b>${esc(session._demoCode)}</b>Real Code requires <code>backend:"supabase"</code>.</div>` : '';
  container.innerHTML = `
    <h2>Verify your email</h2>
    <p class="sub">${CFG.backend === 'supabase' ? 'We sent a 6-digit confirmation code to your inbox.' : 'Enter the code shown below.'}</p>
    <div class="who">Sending to <b>${esc(email)}</b></div>
    ${demoBanner}
    <div class="pin-boxes" id="codeBoxes">${Array.from({length: AUTH.CODE_LENGTH}, (_, i) => `<input type="tel" inputmode="numeric" maxlength="1" autocomplete="one-time-code" data-i="${i}">`).join('')}</div>
    <button class="primary full" id="codeSubmit" disabled>Verify Code</button>
    <button class="link" id="codeResend">Resend code</button>
    <button class="link" id="codeBack">← Use a different email</button>`;

  let codeValue = ''; const boxes = Array.from(container.querySelectorAll('#codeBoxes input')); const submit = $('#codeSubmit');
  const onUpdate = () => { codeValue = boxes.map(b => b.value).join(''); submit.disabled = codeValue.length !== AUTH.CODE_LENGTH; };
  boxes.forEach((input, i) => {
    input.oninput = (e) => { e.target.value = e.target.value.replace(/\D/g, '').slice(0, 1); if (e.target.value && i < boxes.length-1) boxes[i+1].focus(); onUpdate(); if (codeValue.length === AUTH.CODE_LENGTH) setTimeout(() => submit.click(), 120); };
    input.onkeydown = (e) => { if (e.key === 'Backspace' && !e.target.value && i > 0) boxes[i-1].focus(); };
    input.onpaste = (e) => { e.preventDefault(); const paste = (e.clipboardData.getData('text') || '').replace(/\D/g, ''); for (let j=0;j<boxes.length && j<paste.length;j++) boxes[j].value = paste[j]; onUpdate(); if (codeValue.length === AUTH.CODE_LENGTH) setTimeout(() => submit.click(), 120); };
  });
  boxes[0].focus();

  submit.onclick = async () => {
    authMsgClear(); const lock = await lockoutRemaining('code');
    if (lock.ms > 0) return authMsg(`Too many attempts. Locked for ${Math.ceil(lock.ms / 1000)}s.`);
    submit.disabled = true; submit.textContent = 'Verifying…';
    try {
      if (CFG.backend === 'supabase') await supabaseVerifyCode(email, codeValue);
      else await demoVerifyCode(email, codeValue);
      session._demoCode = null; await recordAttempt('code', true); await audit('AUTH code ok ' + email);
      const pinRecord = await getOne(local, 'auth', 'pin.' + session.user.id);
      authView = pinRecord ? 'pin' : 'pin-setup'; renderAuth();
    } catch (err){
      await recordAttempt('code', false); boxes.forEach(b => b.value = ''); boxes[0].focus(); onUpdate(); submit.disabled = false; submit.textContent = 'Verify Code';
      const newLock = await lockoutRemaining('code'); authMsg(newLock.ms > 0 ? `Incorrect code. Locked for ${Math.ceil(newLock.ms / 1000)}s.` : (err.message || 'Incorrect code'));
    }
  };
  $('#codeResend').onclick = async () => {
    const can = await canResendCode(email);
    if (!can.ok) return authMsg(can.waitMs ? `Wait ${Math.ceil(can.waitMs/1000)}s.` : can.reason, 'warn');
    try {
      if (CFG.backend === 'supabase'){ const r = await fetchWithTimeout(CFG.supabaseUrl + '/auth/v1/resend', { method: 'POST', headers: { apikey: CFG.supabaseKey, 'Content-Type': 'application/json' }, body: JSON.stringify({ type: 'signup', email }) }); if (!r.ok){ const e = await r.json().catch(()=>({})); throw new Error(e.msg || 'Resend failed'); } }
      else { const code = randomCode(); await storeDemoCode(email, code); session._demoCode = code; const rec = await getOne(local, 'otp', 'otp.' + email); if (rec){ rec.resends = (rec.resends || 0) + 1; rec.lastResendAt = Date.now(); await putOne(local, 'otp', rec); } }
      await audit('AUTH code resent ' + email); authMsg('A new code has been sent.', 'success'); renderAuth();
    } catch (err){ authMsg('Resend failed: ' + err.message, 'error'); }
  };
  $('#codeBack').onclick = async () => {
    if (session.pendingEmail){ if (CFG.backend === 'demo'){ await delOne(local, 'auth', 'pending_credentials.' + session.pendingEmail); await delOne(local, 'otp', 'otp.' + session.pendingEmail); } session.pendingEmail = null; session._demoCode = null; }
    authView = 'signup'; renderAuth();
  };
}

