async function ensureAuth(){
  if (CFG.backend !== 'supabase') return null;
  if (!session.authenticated) throw new Error('Not authenticated');
  if (session.authToken && session.authExpiry > Date.now() + 60000) return session.authToken;
  if (!session.refreshToken) throw new Error('Session expired');
  const r = await fetchWithTimeout(CFG.supabaseUrl + '/auth/v1/token?grant_type=refresh_token', { method: 'POST', headers: { apikey: CFG.supabaseKey, 'Content-Type': 'application/json' }, body: JSON.stringify({ refresh_token: session.refreshToken }) });
  if (!r.ok){ session.authenticated = false; throw new Error('Session expired'); }
  const d = await r.json(); session.authToken = d.access_token; session.refreshToken = d.refresh_token; session.authExpiry = Date.now() + d.expires_in * 1000;
  return session.authToken;
}
const sbHeaders = () => ({ apikey: CFG.supabaseKey, Authorization: 'Bearer ' + (session.authToken || CFG.supabaseKey) });

async function sbFetch(url, opts){
  await ensureAuth();
  const build = () => ({ ...(opts||{}), headers: { 'Content-Type':'application/json', ...sbHeaders(), ...((opts&&opts.headers)||{}) } });
  let res = await fetchWithTimeout(url, build());
  if (res.status === 401){ session.authToken = null; session.authExpiry = 0; await ensureAuth(); res = await fetchWithTimeout(url, build()); }
  return res;
}

