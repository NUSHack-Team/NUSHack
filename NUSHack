    <div class="pin-boxes" id="pin1">${Array.from({length: AUTH.PIN_LENGTH}, () => `<input type="tel" inputmode="numeric" maxlength="1" autocomplete="off">`).join('')}</div>
    <label>Confirm PIN</label>
    <div class="pin-boxes" id="pin2">${Array.from({length: AUTH.PIN_LENGTH}, () => `<input type="tel" inputmode="numeric" maxlength="1" autocomplete="off">`).join('')}</div>
    <button class="primary full" id="pinSetupSubmit" disabled>Set PIN & sign in</button>
    <div class="hint" style="text-align:center;margin-top:14px">Avoid obvious PINs (000000, 123456).</div>`;

  function wireBoxes(group){
    const boxes = Array.from(group.querySelectorAll('input'));
    boxes.forEach((input, i) => {
      input.oninput = (e) => { e.target.value = e.target.value.replace(/\D/g,'').slice(0,1); if (e.target.value && i < boxes.length-1) boxes[i+1].focus(); update(); };
      input.onkeydown = (e) => { if (e.key === 'Backspace' && !e.target.value && i > 0) boxes[i-1].focus(); };
      input.onpaste = (e) => { e.preventDefault(); const paste = (e.clipboardData.getData('text')||'').replace(/\D/g,''); for (let j=0;j<boxes.length && j<paste.length;j++) boxes[j].value = paste[j]; update(); };
    });
    boxes[0].focus(); return boxes;
  }
  const b1 = wireBoxes($('#pin1')); const b2 = wireBoxes($('#pin2')); const submit = $('#pinSetupSubmit');
  function update(){
    const p1 = b1.map(x=>x.value).join(''); const p2 = b2.map(x=>x.value).join('');
    submit.disabled = !(p1.length === AUTH.PIN_LENGTH && p1 === p2);
    if (p1.length === AUTH.PIN_LENGTH && p2.length === AUTH.PIN_LENGTH && p1 !== p2) authMsg('PINs do not match.', 'error');
    else if (p1 === p2 && p1.length === AUTH.PIN_LENGTH) authMsgClear();
  }
  submit.onclick = async () => {
    const p1 = b1.map(x=>x.value).join(''); const p2 = b2.map(x=>x.value).join('');
    if (p1 !== p2) return authMsg('PINs do not match.', 'error');
    if (p1.length !== AUTH.PIN_LENGTH) return authMsg('PIN must be 6 digits.', 'error');
    if (/^(.)\1{5}$/.test(p1) || ['123456','654321','000000','111111','012345'].includes(p1)) return authMsg('Too obvious.', 'error');
    try {
      const salt = randomSalt(); const hash = await pbkdf2(p1, salt, AUTH.PBKDF2_PIN_ITER);
      await putOne(local, 'auth', { k: 'pin.' + session.user.id, userId: session.user.id, hash, salt: toB64(salt), createdAt: Date.now() });
      await audit('AUTH pin setup ' + session.user.email); session.firewall2 = true; await completeAuth();
    } catch (err){ authMsg('Failed to save PIN: ' + err.message, 'error'); }
  };
}

